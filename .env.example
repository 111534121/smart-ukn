# Smart UKN 環境變數範例：複製需要的項目，在啟動前設定 (PowerShell 範例：$env:DB_PASSWORD = "xxx")
# 全部都有預設值，本機開發可以不設定

# MySQL (init_db.py、seed_data.py、app.py 共用)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smart_ukn          # 正式環境請建立專用帳號，不要用 root
DB_PASSWORD=
DB_NAME=smart_ukn

# 伺服器
HOST=0.0.0.0
PORT=8000
FLASK_DEBUG=0              # 1 = 開啟除錯模式 (僅限本機開發)
SECRET_KEY=                # 未設定時自動產生並存到 data/.secret_key
CORS_ORIGINS=              # 前端另有網域時才需要，逗號分隔，例如 https://app.ukn.edu.tw

# 寄信 (缺曠課與請假審核通知)；未設定 SMTP_HOST 時信件只印在終端機
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls     # starttls / ssl / none
CAMPUS_EMAIL_DOMAIN=stu.ukn.edu.tw

# AI 申辦小幫手：pip install anthropic 並設定金鑰後，由 Claude 根據資料庫內容整理回答 (依用量計費)
# 未設定時只用資料庫比對，功能照常可用。已用 `ant auth login` 登入的機器可改設 ASSISTANT_AI=claude
ANTHROPIC_API_KEY=
ASSISTANT_AI=

# 交通資訊 (TDX 公車 API)，未設定時不顯示即時到站
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 每週紀錄上傳 (tools/weekly_log.py)：安裝 tools/weekly_log_apps_script.gs 後填入
WEEKLY_LOG_URL=
WEEKLY_LOG_TOKEN=
